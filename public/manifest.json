{
  "manifest_version": 3,
  "name": "TS React Chrome Extension",
  "version": "1.0",

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "img/icon-16.png",
      "32": "img/icon-32.png"
    }
  },
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],

  "permissions": ["storage", "activeTab"]
}
